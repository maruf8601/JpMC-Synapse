{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated user profile and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "ForumPost": {
      "title": "ForumPost",
      "description": "Institutional discussion forum post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "topicId": { "type": "string" },
        "topicLabel": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorRole": { "type": "string" },
        "status": { "type": "string", "enum": ["waiting_answer", "solved", "closed"] },
        "isPinned": { "type": "boolean" },
        "isRestricted": { "type": "boolean" },
        "allowedUserIds": { "type": "array", "items": { "type": "string" } },
        "acceptedAnswerId": { "type": "string" },
        "replyCount": { "type": "number" },
        "version": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "lastActivityAt": { "type": "string" }
      },
      "required": ["id", "title", "body", "topicId", "authorId", "authorName", "status", "replyCount", "createdAt", "updatedAt"]
    },
    "ForumComment": {
      "title": "ForumComment",
      "description": "Comment or reply in a discussion post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "postId": { "type": "string" },
        "parentCommentId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorRole": { "type": "string" },
        "body": { "type": "string" },
        "isAcceptedAnswer": { "type": "boolean" },
        "version": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "isDeleted": { "type": "boolean" }
      },
      "required": ["id", "postId", "authorId", "authorName", "body", "createdAt", "updatedAt"]
    },
    "ForumRevision": {
      "title": "ForumRevision",
      "description": "Audit revision record for edited post or comment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "targetType": { "type": "string", "enum": ["post", "comment"] },
        "targetId": { "type": "string" },
        "editorId": { "type": "string" },
        "editorName": { "type": "string" },
        "editorRole": { "type": "string" },
        "isPostAuthor": { "type": "boolean" },
        "editedAt": { "type": "string" },
        "previousContent": { "type": "string" }
      },
      "required": ["id", "targetType", "targetId", "editorId", "editorName", "editedAt", "previousContent"]
    },
    "ForumAttachment": {
      "title": "ForumAttachment",
      "description": "Attachment metadata for Drive-hosted files in discussions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "driveFileId": { "type": "string" },
        "fileName": { "type": "string" },
        "fileSize": { "type": "number" },
        "mimeType": { "type": "string" },
        "uploaderId": { "type": "string" },
        "uploaderName": { "type": "string" },
        "isRestricted": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "driveFileId", "fileName", "fileSize", "mimeType", "uploaderId", "createdAt"]
    },
    "Event": {
      "title": "Event",
      "description": "Official schedule and meeting record of Jamalpur Medical College",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "eventDate": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "venue": { "type": "string" },
        "category": { "type": "string" },
        "priority": { "type": "string", "enum": ["normal", "important", "urgent"] },
        "source": { "type": "string", "enum": ["Telegram", "Google Calendar", "Manual", "AI Extracted"] },
        "sourceId": { "type": "string" },
        "telegramMessageId": { "type": "number" },
        "telegramChatId": { "type": "string" },
        "googleCalendarEventId": { "type": "string" },
        "originalText": { "type": "string" },
        "confidence": { "type": "number" },
        "reviewStatus": { "type": "string", "enum": ["auto_approved", "needs_review", "rejected"] },
        "syncStatus": { "type": "string", "enum": ["synced", "pending", "failed", "local_only"] },
        "participants": { "type": "string" },
        "committee": { "type": "string" },
        "notes": { "type": "string" },
        "isAllDay": { "type": "boolean" },
        "isCompleted": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "eventDate", "startTime", "venue", "category", "priority", "source", "reviewStatus", "syncStatus", "createdAt", "updatedAt"]
    },
    "Device": {
      "title": "Device",
      "description": "Registered client browser or PWA device for background push notifications",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string" },
        "userId": { "type": "string" },
        "fcmToken": { "type": "string" },
        "platform": { "type": "string" },
        "userAgent": { "type": "string" },
        "notificationsEnabled": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "lastSeenAt": { "type": "string" }
      },
      "required": ["deviceId", "fcmToken", "platform", "notificationsEnabled"]
    },
    "NotificationDelivery": {
      "title": "NotificationDelivery",
      "description": "Idempotent log of delivered push notifications to prevent duplicate alerts",
      "type": "object",
      "properties": {
        "deliveryId": { "type": "string" },
        "eventId": { "type": "string" },
        "deviceId": { "type": "string" },
        "userId": { "type": "string" },
        "fcmToken": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "status": { "type": "string", "enum": ["sent", "failed"] },
        "error": { "type": "string" },
        "deliveredAt": { "type": "string" }
      },
      "required": ["deliveryId", "deviceId", "type", "title", "body", "status", "deliveredAt"]
    },
    "TelegramMessage": {
      "title": "TelegramMessage",
      "description": "Raw ingested Telegram notice or document with idempotency metadata",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "messageId": { "type": "number" },
        "chatId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string" },
        "originalSenderName": { "type": "string" },
        "originalSenderRole": { "type": "string" },
        "timestamp": { "type": "string" },
        "rawText": { "type": "string" },
        "hasDocument": { "type": "boolean" },
        "documentType": { "type": "string" },
        "documentName": { "type": "string" },
        "mimeType": { "type": "string" },
        "fileSize": { "type": "number" },
        "telegramFileId": { "type": "string" },
        "caption": { "type": "string" },
        "processingStatus": { "type": "string" },
        "extractionStatus": { "type": "string" },
        "status": { "type": "string", "enum": ["Received", "Processing", "Processed", "Schedule Created", "Review Required", "Needs Review", "Not a Schedule", "Duplicate", "Download Failed", "Gemini Processing Failed", "Processing Failed", "Unsupported Document"] },
        "confidence": { "type": "number" },
        "receivedAt": { "type": "string" },
        "processedAt": { "type": "string" }
      },
      "required": ["id", "chatId", "senderName", "timestamp", "rawText", "hasDocument", "status", "confidence"]
    },
    "ProcessingJob": {
      "title": "ProcessingJob",
      "description": "Background AI ingestion job for notice extraction and verification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "processing", "completed", "failed"] },
        "errorMessage": { "type": "string" },
        "createdAt": { "type": "string" },
        "completedAt": { "type": "string" }
      },
      "required": ["id", "type", "status", "createdAt"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Application preferences and integration configurations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "key": { "type": "string" },
        "value": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "key", "value", "updatedAt"]
    },
    "SyncMetadata": {
      "title": "SyncMetadata",
      "description": "Tracking Google Calendar and automated cloud backup statuses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "service": { "type": "string" },
        "lastSyncAt": { "type": "string" },
        "status": { "type": "string" },
        "itemsSynced": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "service", "lastSyncAt", "status", "updatedAt"]
    },
    "Reminder": {
      "title": "Reminder",
      "description": "Scheduled notifications and morning briefing alarms for schedules",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventId": { "type": "string" },
        "reminderType": { "type": "string", "enum": ["notification", "alarm", "morning_briefing"] },
        "minutesBefore": { "type": "number" },
        "scheduledAt": { "type": "string" },
        "enabled": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "eventId", "reminderType", "minutesBefore", "scheduledAt", "enabled"]
    },
    "AuthorizedUser": {
      "title": "AuthorizedUser",
      "description": "Registry of authorized staff users with active access permissions",
      "type": "object",
      "properties": {
        "active": { "type": "boolean" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["active"]
    },
    "UserPreference": {
      "title": "UserPreference",
      "description": "User preferences including about version seen flag",
      "type": "object",
      "properties": {
        "aboutVersionSeen": { "type": "string" },
        "language": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Popup announcements published by JpMC administrators",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "priority": { "type": "string", "enum": ["normal", "important", "urgent"] },
        "displayMode": { "type": "string", "enum": ["show_once", "show_every_open", "require_acknowledgement"] },
        "targetAudience": { "type": "string", "enum": ["everyone", "admins_only", "users_only"] },
        "active": { "type": "boolean" },
        "status": { "type": "string", "enum": ["draft", "published", "expired"] },
        "startAt": { "type": "string" },
        "expiresAt": { "type": "string" },
        "sendPush": { "type": "boolean" },
        "pushSentAt": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "message", "priority", "displayMode", "targetAudience", "active", "status", "startAt", "expiresAt", "sendPush"]
    },
    "AnnouncementReceipt": {
      "title": "AnnouncementReceipt",
      "description": "User interaction receipt for an announcement",
      "type": "object",
      "properties": {
        "announcementId": { "type": "string" },
        "uid": { "type": "string" },
        "seenAt": { "type": "string" },
        "acknowledgedAt": { "type": "string" }
      },
      "required": ["announcementId", "uid", "seenAt"]
    },
    "ChatConversation": {
      "title": "ChatConversation",
      "description": "One-to-one interdepartmental chat thread between authorized JpMC staff",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participantIds": { "type": "array", "items": { "type": "string" } },
        "lastMessageAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "participantIds", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Institutional chat message with 72-hour TTL and admin retention metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "image", "pdf", "document"] },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" },
        "deletedByUser": { "type": "boolean" }
      },
      "required": ["id", "conversationId", "senderId", "receiverId", "content", "type", "createdAt", "expiresAt"]
    },
    "ChatAttachment": {
      "title": "ChatAttachment",
      "description": "Encrypted or secured institutional attachment with 72-hour TTL",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "uploaderId": { "type": "string" },
        "filename": { "type": "string" },
        "mimeType": { "type": "string" },
        "size": { "type": "number" },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" }
      },
      "required": ["id", "conversationId", "uploaderId", "filename", "mimeType", "size", "createdAt", "expiresAt"]
    },
    "ChatAdminAuditLog": {
      "title": "ChatAdminAuditLog",
      "description": "Administrative access audit trail for institutional chat oversight",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "adminId": { "type": "string" },
        "action": { "type": "string" },
        "conversationId": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "adminId", "action", "conversationId", "timestamp"]
    }
  },
  "firestore": {
    "/conversations/{conversationId}": {
      "schema": "ChatConversation",
      "description": "One-to-one chat conversations"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Chat messages with 72-hour retention"
    },
    "/chatAttachments/{attachmentId}": {
      "schema": "ChatAttachment",
      "description": "Institutional chat attachments with 72-hour retention"
    },
    "/chatAdminAuditLogs/{logId}": {
      "schema": "ChatAdminAuditLog",
      "description": "Admin oversight access audit logs"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Official institutional popup announcements"
    },
    "/announcementReceipts/{receiptId}": {
      "schema": "AnnouncementReceipt",
      "description": "User seen and acknowledgement status per announcement"
    },
    "/userPreferences/{userId}": {
      "schema": "UserPreference",
      "description": "Persistent onboarding and user preferences"
    },
    "/authorizedUsers/{userId}": {
      "schema": "AuthorizedUser",
      "description": "Registry of active staff users authorized to access events and settings"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and permissions"
    },
    "/users/{userId}/devices/{deviceId}": {
      "schema": "Device",
      "description": "User registered push notification tokens"
    },
    "/devices/{deviceId}": {
      "schema": "Device",
      "description": "Global device registry for push notifications"
    },
    "/notificationDeliveries/{deliveryId}": {
      "schema": "NotificationDelivery",
      "description": "Idempotent log of delivered push notifications"
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Collection of all hospital and college events"
    },
    "/telegramMessages/{messageDocId}": {
      "schema": "TelegramMessage",
      "description": "Ingested Telegram messages with deduplication checks"
    },
    "/processingJobs/{jobId}": {
      "schema": "ProcessingJob",
      "description": "Background processing jobs tracking"
    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "Global and user-level settings"
    },
    "/syncMetadata/{metaId}": {
      "schema": "SyncMetadata",
      "description": "Sync status records for Google Calendar and Drive"
    },
    "/reminders/{reminderId}": {
      "schema": "Reminder",
      "description": "Scheduled notification reminders"
    },
    "/forum_posts/{postId}": {
      "schema": "ForumPost",
      "description": "Discussion forum posts"
    },
    "/forum_comments/{commentId}": {
      "schema": "ForumComment",
      "description": "Discussion forum comments and nested replies"
    },
    "/forum_revisions/{revisionId}": {
      "schema": "ForumRevision",
      "description": "Discussion edit history revisions"
    },
    "/forum_attachments/{attachmentId}": {
      "schema": "ForumAttachment",
      "description": "Google Drive forum attachment metadata"
    }
  }
}
