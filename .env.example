# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Telegram Bot API Token from @BotFather (e.g. 123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11)
TELEGRAM_BOT_TOKEN=

# TELEGRAM_WEBHOOK_SECRET: Security token for validating incoming Telegram webhooks (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=

# FIREBASE_PROJECT_ID: Cloud Firestore & Firebase project ID (defaults to sapient-pen-336609)
FIREBASE_PROJECT_ID=sapient-pen-336609

# FIREBASE_SERVICE_ACCOUNT_KEY: Optional JSON credentials string for Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT_KEY=

# VITE_GOOGLE_CLIENT_ID: Optional Google OAuth Web Client ID for Google Calendar sync
VITE_GOOGLE_CLIENT_ID=

# SCHEDULER_SECRET: Secret token for authenticating Google Cloud Scheduler HTTP POST requests to /api/internal/*
SCHEDULER_SECRET=

# ADMIN_SECRET: Secret token for administrative operations and webhook provisioning
ADMIN_SECRET=

# ENABLE_LOCAL_SCHEDULER: Set to "true" only for local offline debugging (starts in-process setInterval)
ENABLE_LOCAL_SCHEDULER=false

# VITE_ENABLE_DEMO_DATA: Set to "true" to seed initial demo events if database is empty in dev
VITE_ENABLE_DEMO_DATA=false

