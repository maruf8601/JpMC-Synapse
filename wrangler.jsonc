{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jpmc-synapse",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "triggers": {
    "crons": [
      "* * * * *",
      "30 1 * * *"
    ]
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "sapient-pen-336609"
  },
  "secrets": {
    "required": [
      "FIREBASE_SERVICE_ACCOUNT_KEY",
      "GEMINI_API_KEY",
      "SCHEDULER_SECRET",
      "STAFF_ACCESS_CODE",
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_WEBHOOK_SECRET"
    ]
  }
}
