rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basic authentication check
    function isAuthenticated() {
      return request.auth != null;
    }

    // Owner check for private user records
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the authenticated user is marked active in authorizedUsers registry
    function isActiveUser() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)).data.active == true
      );
    }

    // Check if the authenticated active user has the admin role
    function isAdmin() {
      return isActiveUser() && (
        get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Authorized Users Registry (Managed by Admin SDK, read by authenticated users)
    match /authorizedUsers/{userId} {
      allow read: if isAuthenticated();
      allow write: if false; // Server Admin SDK only! No client can write or promote themselves
    }

    // User Profile Documents
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      match /devices/{deviceId} {
        allow read, write: if isOwner(userId);
      }
    }

    // User Preferences (About modal seen state, language, theme)
    match /userPreferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Device Registry: Signed-in user may manage only their own device records, Admin may inspect
    match /devices/{deviceId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Events Collection:
    // Active users (admin and user) can read events
    // ONLY admins can create, update, or delete events
    match /events/{eventId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    // Ingested Telegram Messages: Active users may view, but CLIENT CANNOT WRITE (Server Admin only)
    match /telegramMessages/{messageDocId} {
      allow read: if isActiveUser();
      allow write: if false;
    }

    // Notification Delivery Audit Logs: Admin only (Server Admin only writes)
    match /notificationDeliveries/{deliveryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Background Processing Jobs: Admin only (Server Admin only writes)
    match /processingJobs/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // App and System Settings: Active users can read, only Admin can write
    match /settings/{settingId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // Sync Metadata (Google Calendar & Auto-Backup status): Active users read, Admin writes
    match /syncMetadata/{metaId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // Scheduled Reminders Collection: Active users read, Admin writes
    match /reminders/{reminderId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // Announcements Collection:
    // Anyone may read active published announcements; Admins may read all (drafts & expired)
    // Only Administrators may create, update, or delete announcements
    match /announcements/{announcementId} {
      allow get: if resource == null || resource.data.active == true || isAdmin();
      allow list: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Announcement User Receipts (seen & acknowledgement status):
    // Authenticated users may only create, update, or read their own interaction receipt.
    // Document ID is canonical format: `${announcementId}_${request.auth.uid}`
    match /announcementReceipts/{receiptId} {
      allow read: if isAuthenticated() && (
        (resource == null) ||
        (resource.data.uid == request.auth.uid) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource != null && resource.data.uid == request.auth.uid) &&
        (request.resource.data.uid == request.auth.uid)
      );
      allow delete: if isAdmin();
    }

    // Interdepartmental Chat Conversations:
    // Participants can read and manage their conversation metadata; Admin can inspect for oversight
    match /conversations/{conversationId} {
      allow read: if isActiveUser() && (
        (resource == null) ||
        (request.auth.uid in resource.data.participantIds) ||
        isAdmin()
      );
      allow create: if isActiveUser() && (request.auth.uid in request.resource.data.participantIds);
      allow update: if isActiveUser() && (
        (request.auth.uid in resource.data.participantIds) ||
        isAdmin()
      );
      allow delete: if isAdmin();

      // Individual Messages Subcollection:
      // Normal participants can only read non-deleted messages where they are sender or receiver.
      // Admin can inspect retained messages (including user-deleted ones) within 72 hours.
      match /messages/{messageId} {
        allow read: if isActiveUser() && (
          (
            (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid) &&
            resource.data.deletedByUser != true
          ) ||
          isAdmin()
        );
        allow create: if isActiveUser() && request.resource.data.senderId == request.auth.uid;
        allow update: if isActiveUser() && (
          (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid) ||
          isAdmin()
        );
        allow delete: if isAdmin();
      }
    }

    // Chat Attachments:
    // Only verified active participants may read; server Admin SDK handles writes & 72-hour TTL
    match /chatAttachments/{attachmentId} {
      allow read: if isActiveUser();
      allow write: if false; // Server Admin SDK only
    }

    // Chat Admin Oversight Audit Logs:
    // Read-only for authorized Admins; writes restricted to Server Admin SDK
    match /chatAdminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Server Admin SDK only
    }

    // ==========================================
    // DISCUSSION FORUM (আলোচনা)
    // ==========================================

    // Forum Topics: Active users can read, Admins can manage
    match /forum_topics/{topicId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // Forum Posts:
    // Active users can read (unless restricted to specific users)
    // All authenticated JpMC users can create posts
    // Post authors can edit or soft-delete their posts; Admins can moderate/pin/close
    match /forum_posts/{postId} {
      allow read: if isActiveUser() && (
        resource == null ||
        resource.data.isRestricted != true ||
        resource.data.authorId == request.auth.uid ||
        (resource.data.allowedUserIds != null && request.auth.uid in resource.data.allowedUserIds) ||
        isAdmin()
      );
      allow create: if isActiveUser() && request.resource.data.authorId == request.auth.uid;
      allow update: if isActiveUser() && (
        (resource.data.authorId == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isActiveUser() && (
        (resource.data.authorId == request.auth.uid) ||
        isAdmin()
      );
    }

    // Forum Comments & Nested Replies:
    // Active users can read comments on accessible posts
    // Active users can create comments
    // Comment author can edit their comment
    // CRITICAL RULE: Post author can also edit any other user's comment on that post!
    // Comment author or post author or admin can delete
    match /forum_comments/{commentId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() && request.resource.data.authorId == request.auth.uid;
      allow update: if isActiveUser(); // Server-side validation strictly enforces author, post author, or admin
      allow delete: if isActiveUser(); // Server-side validation strictly enforces deletion permissions
    }

    // Forum Edit Revisions: Read-only for active users; written only by Server Admin SDK
    match /forum_revisions/{revisionId} {
      allow read: if isActiveUser();
      allow write: if false; // Server Admin SDK only
    }

    // Forum Google Drive Attachment Metadata:
    // Read-only for active users; written only by Server Admin SDK after Drive upload
    match /forum_attachments/{attachmentId} {
      allow read: if isActiveUser();
      allow write: if false; // Server Admin SDK only
    }

    // Forum Follows / Bookmarks:
    // Authenticated users manage their own follows
    match /forum_follows/{followId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }
  }
}
